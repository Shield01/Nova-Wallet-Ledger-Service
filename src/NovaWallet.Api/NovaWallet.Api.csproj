<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- XML doc comments feed the OpenAPI descriptions; not every member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NovaWallet.Application\NovaWallet.Application.csproj" />
    <ProjectReference Include="..\NovaWallet.Domain\NovaWallet.Domain.csproj" />
    <ProjectReference Include="..\NovaWallet.Infrastructure\NovaWallet.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
