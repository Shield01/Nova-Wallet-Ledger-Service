{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Health": {
    "ReadinessTimeoutMilliseconds": 3000,
    "ReadinessCacheMilliseconds": 1000
  },
  "Auth": {
    "Issuer": "novawallet-dev-issuer",
    "Audience": "novawallet-api",
    "TokenLifetimeMinutes": 15,
    "DevIssuer": {
      "Enabled": false
    }
  },
  "Limits": {
    "DailyOutboundKobo": 50000000
  },
  "Database": {
    "LockTimeoutMilliseconds": 5000
  },
  "RateLimiting": {
    "Transfers": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "OpenApi": {
    "Enabled": true
  }
}
