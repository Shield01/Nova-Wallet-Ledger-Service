# Copy to .env and fill in to override the development defaults in docker-compose.yml.
# Values are deliberately left empty: an unset variable falls back to the labelled dev default.
# POSTGRES_PASSWORD=
# NOVAWALLET_OWNER_PASSWORD=
# NOVAWALLET_APP_PASSWORD=
# NOVAWALLET_SIGNING_KEY=   (at least 32 bytes of randomness, e.g. `openssl rand -hex 32`)
